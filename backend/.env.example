# Server environment
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgres://postgres:your_local_db_password@localhost:5432/worldr_db


# JWT Token secrets (Ensure these are long, random secure strings in production)
JWT_ACCESS_SECRET=your_32_character_jwt_access_secret_string_here_12345
JWT_REFRESH_SECRET=your_32_character_jwt_refresh_secret_string_here_12345

# Email Configuration (Brevo API)
EMAIL_PROVIDER=brevo_api
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=no-reply@worldr.game
EMAIL_VERIFICATION_REQUIRED=false

# ── Security & operations (Phase 0) ────────────────────────────────────────
# Comma-separated emails that get admin rights (promoted in the DB on boot).
ADMIN_EMAILS=
# Comma-separated browser origins allowed to call the API, e.g. https://your-game.vercel.app
# Leave empty only for local development.
CORS_ORIGINS=
# Sentry error tracking (optional). Get a DSN from sentry.io → Project → Client Keys.
SENTRY_DSN=
# Shared secret for the GitHub Actions tick/health workflows (X-Tick-Secret header).
TICK_SECRET=
# /health reports the world as "overdue" once a tick is this many minutes late.
TICK_OVERDUE_GRACE_MINUTES=30
